    <Method Name="OnSerializeTypeWith" Id="{a831d171-0d53-088d-1722-aba40f567dba}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED OnSerializeTypeWith
VAR_INPUT
	Serializer : I_Serializer;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Serializer.AddKeyString('typeName',TypeName);]]></ST>
      </Implementation>
