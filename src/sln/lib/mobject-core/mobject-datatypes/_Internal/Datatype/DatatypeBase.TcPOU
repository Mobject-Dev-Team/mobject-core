    <Method Name="TryCopyFrom" Id="{dda7c095-b8c6-0f87-2d33-9c86847656e6}">
      <Declaration><![CDATA[METHOD PUBLIC TryCopyFrom : BOOL
VAR_INPUT
	Source : I_Datatype;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT IsEquivalentTo(Source) THEN
	RETURN;
END_IF

memcpy(Address, Source.Address, Size);
TryCopyFrom := TRUE;]]></ST>
      </Implementation>
    </Method>
