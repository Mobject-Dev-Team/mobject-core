    <Method Name="Clone" Id="{87a9e5f0-56c4-0dc7-38ef-a3c1c3c29bcd}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Datatype
VAR
    pClone : POINTER TO _REFERENCE_TO;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pClone := __NEW(_REFERENCE_TO(RefTo := _target));
Clone := pClone^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{4488cff1-fc79-0c26-3d56-471c036d96ba}" FolderPath="Constructor\">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)  
	RefTo : I_Datatype; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF RefTo = 0 THEN
	RETURN;
END_IF

this^._target := RefTo;]]></ST>
      </Implementation>
    </Method>
