  <POU Name="_REFERENCE_TO" Id="{3d3d9a52-c096-0687-2956-e5a8f291cf53}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'} 
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK _REFERENCE_TO EXTENDS Disposable IMPLEMENTS I_REFERENCE_TO
VAR
	nullTarget : _NULL;
	_target : I_Datatype := nullTarget;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{b5b29d87-9717-0151-11f2-d6904c353178}" />
