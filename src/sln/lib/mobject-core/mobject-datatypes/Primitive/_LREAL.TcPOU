END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TypeName := 'LREAL';]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Value" Id="{27002f84-6748-4a80-8b6e-791fe85a74b0}">
      <Declaration><![CDATA[{warning disable C5410}
PROPERTY PUBLIC Value : REFERENCE TO LREAL
{warning restore C5410}]]></Declaration>
      <Get Name="Get" Id="{d571196e-195c-458a-90d9-7091d9058e54}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Value REF= activeData;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
