    <Method Name="SerializeTypeWith" Id="{7305326e-da02-024f-3f53-1879345200a8}">
      <Declaration><![CDATA[METHOD PUBLIC SerializeTypeWith
VAR_INPUT
	Serializer : I_Serializer;
END_VAR]]></Declaration>
      <Implementation>
