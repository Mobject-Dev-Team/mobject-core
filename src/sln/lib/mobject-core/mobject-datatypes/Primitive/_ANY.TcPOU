    <Method Name="TryBecome" Id="{cfab167a-2a24-0ac9-2f44-f1f7b67543dc}">
      <Declaration><![CDATA[METHOD PUBLIC TryBecome : BOOL
VAR_INPUT
	Target : I_Datatype;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT CanBecome(Target) THEN
	RETURN;
END_IF

CreateResolvedDatatype(Target);
TryBecome := TRUE;]]></ST>
      </Implementation>
    </Method>
