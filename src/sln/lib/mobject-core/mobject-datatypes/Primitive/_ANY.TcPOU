        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF resolvedDatatype = 0 THEN
	RETURN;
END_IF

Address := resolvedDatatype.Address;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CanBecome" Id="{82bbea03-e810-00a2-2c24-e749d9fdcd14}">
      <Declaration><![CDATA[METHOD PUBLIC CanBecome : BOOL
VAR_INPUT
	Target : I_Datatype;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CanBecome := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clear" Id="{74df08ba-8fd1-00ae-20ae-8ccb8c980636}">
      <Declaration><![CDATA[METHOD PUBLIC Clear
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[DestroyResolvedDatatype();]]></ST>
      </Implementation>
    </Method>
