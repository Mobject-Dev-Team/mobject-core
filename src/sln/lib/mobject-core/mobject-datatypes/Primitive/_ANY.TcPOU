  <POU Name="_ANY" Id="{934a0bfd-87e5-07e2-2196-07f5c55c1068}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'} 
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK _ANY EXTENDS Disposable IMPLEMENTS I_Any
VAR
	resolvedDatatype : I_Datatype;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Destructor" Id="{201b3579-77f1-0a59-3a03-d8105058fa45}" />
    <Folder Name="Private" Id="{efe905a5-6af8-0963-2499-94f2ca1a3df6}" />
    <Method Name="Accept" Id="{9d6a9f03-6376-09aa-2595-715e715a6ada}">
      <Declaration><![CDATA[METHOD PUBLIC Accept
VAR_INPUT
	Visitor : I_DatatypeVisitor;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF resolvedDatatype = 0 THEN
	Visitor.VisitDatatype(THIS^);
	RETURN;
END_IF

Visitor.VisitDatatype(resolvedDatatype);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Address" Id="{8de9ca49-8c61-0be7-395f-a23669223534}">
      <Declaration><![CDATA[PROPERTY PUBLIC Address : PVOID]]></Declaration>
