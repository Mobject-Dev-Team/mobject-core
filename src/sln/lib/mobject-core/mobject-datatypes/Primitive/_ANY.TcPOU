    <Method Name="Clone" Id="{fba5394f-dcaa-0d82-30d4-3746a85090cd}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Datatype
VAR
    pClone : POINTER TO _ANY;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF resolvedDatatype = 0 THEN
	pClone := __NEW(_ANY);
	Clone := pClone^;
	RETURN;
END_IF

Clone := resolvedDatatype.Clone();]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateResolvedDatatype" Id="{946679ec-a6ff-0944-010d-a65b35933f8a}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE CreateResolvedDatatype
VAR_INPUT
	DatatypeToClone : I_Datatype;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[DestroyResolvedDatatype();
resolvedDatatype := DatatypeToClone.Clone();]]></ST>
      </Implementation>
    </Method>
    <Method Name="DestroyResolvedDatatype" Id="{2a636094-e69f-0724-1c47-e678dda8ae0d}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE DestroyResolvedDatatype
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF resolvedDatatype = 0 THEN
	RETURN;
END_IF

resolvedDatatype.Dispose();
resolvedDatatype := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{16856200-56ee-0e26-328c-fa38ea5833ef}" FolderPath="Destructor\">
      <Declaration><![CDATA[METHOD FB_exit : BOOL
VAR_INPUT
	(* if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).*)
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bInCopyCode THEN
	RETURN;
END_IF

DestroyResolvedDatatype();]]></ST>
      </Implementation>
    </Method>
